LEARNING_AGENT_HOST=127.0.0.1
LEARNING_AGENT_PORT=18034
LEARNING_AGENT_DB_PATH=.data/learning-agent-web.sqlite
# 开发默认使用线上代理，生产默认使用 http://127.0.0.1:18033。
BAICIZHAN_HELPER_API_BASE_URL=

# 学习路线规划所需的服务端配置。BASE_URL 填写服务的兼容 API 根地址。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=32768
# 兼容服务需要旧参数时设为 max_tokens；不会通过重发请求探测兼容性。
OPENAI_TOKEN_LIMIT_FIELD=max_completion_tokens
